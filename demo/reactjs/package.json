{
  "name": "@convertcom/js-sdk-demo-react",
  "version": "1.0.0",
  "author": "Convert Insights, Inc",
  "license": "Apache-2.0",
  "dependencies": {
    "feather-icons": "^4.29.2",
    "framer-motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.1.19",
    "tailwindcss": "^3.4.4",
    "twin.macro": "^3.4.1"
  },
  "peerDependencies": {
    "@convertcom/js-sdk": ">=2.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "watch": {
    "build": {
      "patterns": [
        "."
      ],
      "ignore": "build",
      "extensions": "*",
      "quiet": false
    }
  },
  "eslintConfig": {
    "extends": "react-app",
    "overrides": [
      {
        "files": [
          "src/**/*.js"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off",
          "react-hooks/exhaustive-deps": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-macros": "^3.1.0",
    "vite": "^7.3.5",
    "vite-plugin-svgr": "^4.5.0"
  }
}
