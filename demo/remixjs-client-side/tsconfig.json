{
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "noEmit": true,
    "types": [
      "@react-router/node",
      "vite/client"
    ],
    "module": "ESNext",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  },
  "include": [
    ".react-router/types/**/*",
    "**/*.ts",
    "**/*.tsx"
  ]
}
